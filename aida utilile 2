
/* ============================================================
   CE QUE L'UTILISATEUR VEUT VOIR
   ============================================================ */

int lire_nombre(const char *question, int min, int max) {
    char buf[100];
    int val;

    while (1) {
        printf("%s", question);
        if (fgets(buf, sizeof(buf), stdin) == NULL) {
            return -1;
        }
        if (sscanf(buf, " %d", &val) == 1 && val >= min && val <= max) {
            return val;
        }
        printf("Choix invalide : entrez un nombre entre %d et %d.\n", min, max);
    }
}

int demander_choix_utilisateur(ChoixAffichage *choix) {
    printf("\n============================================================\n");
    printf("   QUE VOULEZ-VOUS AFFICHER ?\n");
    printf("============================================================\n");

    printf("1. Type de statistique :\n");
    printf("   1 -> Par type d'usager (conducteur, passager, pieton)\n");
    printf("   2 -> Par genre (homme, femme)\n");
    choix->mode_stats = lire_nombre("Votre choix (1 ou 2) : ", 1, 2);
    if (choix->mode_stats == -1) return 0;

    printf("\n2. Filtre type d'usager :\n");
    printf("   0 -> Tous   1 -> Conducteur   2 -> Passager   3 -> Pieton\n");
    choix->filtre_type = lire_nombre("Votre choix (0 a 3) : ", 0, 3);
    if (choix->filtre_type == -1) return 0;

    printf("\n3. Filtre genre :\n");
    printf("   0 -> Tous   1 -> Homme   2 -> Femme\n");
    choix->filtre_genre = lire_nombre("Votre choix (0 a 2) : ", 0, 2);
    if (choix->filtre_genre == -1) return 0;

    return 1;
}


/* ============================================================
   CALCULS ET PYRAMIDE DES AGES
   ============================================================ */

/* genre_filtre : 0 = tous, 1 = homme (idx 0), 2 = femme (idx 1) */
int compter_noeud(NoeudAge *n, int type, int genre_filtre) {
    if (type > 0 && genre_filtre > 0) {
        return n->croise[type][genre_filtre - 1];
    }
    if (type > 0) {
        return n->types[type];
    }
    if (genre_filtre > 0) {
        return n->genres[genre_filtre - 1];
    }
    return n->total;
}

int calculer_total_filtre(ListeAges *liste, ChoixAffichage choix) {
    int total = 0;
    NoeudAge *courant = liste->tete;

    while (courant != NULL) {
        if (choix.mode_stats == 1) {
            int deb = (choix.filtre_type == 0) ? 1 : choix.filtre_type;
            int fin = (choix.filtre_type == 0) ? 3 : choix.filtre_type;
            for (int t = deb; t <= fin; t++) {
                total += compter_noeud(courant, t, choix.filtre_genre);
            }
        } else {
            int deb = (choix.filtre_genre == 0) ? 1 : choix.filtre_genre;
            int fin = (choix.filtre_genre == 0) ? 2 : choix.filtre_genre;
            for (int g = deb; g <= fin; g++) {
                total += compter_noeud(courant, choix.filtre_type, g);
            }
        }
        courant = courant->suivant;
    }

    return total;
}

int nb_diezes(double pct) {
    int n = (int)(pct / 5.0);
    if (pct > 0.0 && n == 0) {
        n = 1;
    }
    if (n > MAX_BARRE) {
        n = MAX_BARRE;
    }
    return n;
}

void afficher_ligne_type(NoeudAge *n, int total_global, ChoixAffichage choix) {
    const char *noms[4] = { "", "Conducteur", "Passager", "Pieton" };
    int deb = (choix.filtre_type == 0) ? 1 : choix.filtre_type;
    int fin = (choix.filtre_type == 0) ? 3 : choix.filtre_type;

    int somme = 0;
    for (int t = deb; t <= fin; t++) {
        somme += compter_noeud(n, t, choix.filtre_genre);
    }
    if (somme == 0) {
        return;
    }

    printf("\nAge %3d ans :\n", n->age);
    for (int t = deb; t <= fin; t++) {
        int nb = compter_noeud(n, t, choix.filtre_genre);
        double pct = (nb * 100.0) / total_global;
        int d = nb_diezes(pct);

        printf("  %-10s | ", noms[t]);
        for (int i = 0; i < d; i++) printf("#");
        for (int i = d; i < MAX_BARRE; i++) printf(" ");
        printf(" | %4d (%5.1f%%)\n", nb, pct);
    }
}

void afficher_ligne_genre(NoeudAge *n, int total_global, ChoixAffichage choix) {
    int h = (choix.filtre_genre == 2) ? 0 : compter_noeud(n, choix.filtre_type, 1);
    int f = (choix.filtre_genre == 1) ? 0 : compter_noeud(n, choix.filtre_type, 2);

    if (h == 0 && f == 0) {
        return;
    }

    double pct_h = (h * 100.0) / total_global;
    double pct_f = (f * 100.0) / total_global;
    int bh = nb_diezes(pct_h);
    int bf = nb_diezes(pct_f);

    for (int i = 0; i < MAX_BARRE - bh; i++) printf(" ");
    for (int i = 0; i < bh; i++) printf("#");

    printf(" | %3d | ", n->age);

    for (int i = 0; i < bf; i++) printf("#");
    for (int i = bf; i < MAX_BARRE; i++) printf(" ");

    printf(" | H: %3d (%4.1f%%) | F: %3d (%4.1f%%)\n", h, pct_h, f, pct_f);
}

void afficher_noeuds_haut_en_bas(NoeudAge *n, int total_global, ChoixAffichage choix) {
    if (n == NULL) {
        return;
    }
    afficher_noeuds_haut_en_bas(n->suivant, total_global, choix);

    if (choix.mode_stats == 1) {
        afficher_ligne_type(n, total_global, choix);
    } else {
        afficher_ligne_genre(n, total_global, choix);
    }
}

void afficher_pyramide(ListeAges *liste, ChoixAffichage choix) {
    int total_global = calculer_total_filtre(liste, choix);
    if (total_global == 0) {
        printf("\nAucune victime ne correspond a ces filtres.\n");
        return;
    }

    printf("\n============================================================\n");
    printf("PYRAMIDE DES AGES (Total filtre : %d)\n", total_global);
    printf("============================================================\n");

    if (choix.mode_stats == 2) {
        for (int i = 0; i < MAX_BARRE - 6; i++) printf(" ");
        printf("HOMMES | AGE | FEMMES\n");
    }

    afficher_noeuds_haut_en_bas(liste->tete, total_global, choix);
    printf("\n============================================================\n");
}


/* ============================================================
   MENU ET MAIN
   ============================================================ */

void menu_age_data(ListeAges *liste) {
    ChoixAffichage premier_choix = { 2, 0, 0 };
    afficher_pyramide(liste, premier_choix);

    while (1) {
        printf("\n--- MENU AGE_DATA ---\n");
        printf("1. Choisir les statistiques et filtres\n");
        printf("0. Quitter\n");

        int action = lire_nombre("Votre choix : ", 0, 1);
        if (action <= 0) {
            break;
        }

        ChoixAffichage choix;
        if (!demander_choix_utilisateur(&choix)) {
            break;
        }

        afficher_pyramide(liste, choix);
    }
}

int main(int argc, char *argv[]) {
    ListeAges liste;
    liste.tete = NULL;

    if (argc >= 3 && strcmp(argv[1], "AGE_DATA") == 0) {
        if (!charger_csv(argv[2], &liste)) {
            liberer_liste(&liste);
            return 1;
        }
    } else {
        charger_exemples(&liste);
    }

    menu_age_data(&liste);
    liberer_liste(&liste);
    return 0;
}
